{
  "compilerOptions": {
    "target": "es2021",
    "module": "esnext",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "noEmit": false,
    "declaration": true
  },
  "include": ["src"]
}
